@article{Brancatelli2027,
  author = {Brancatelli, Giuseppe and Lipari, Vincenzo and Forlin, Edy and Pignelli, Rogerio and Busetti, Martina and Geletti, Riccardo},
  title = {Joint training across streamer geometries for missing-trace reconstruction: A comparative evaluation on real marine data},
  journal = {Journal of Applied Geophysics},
  volume = {256},
  pages = {106621},
  year = {2027},
  doi = {10.1016/j.jappgeo.2026.106621},
  note = {Volume 256, article 106621.},
  abstract = {Can one interpolation model serve marine surveys recorded with different streamer lengths? We evaluate joint
    training across geometries with a compact U-Net and the larger published U-Net of Chai and co-workers, asking
    how backbone, objective and geometry conditioning affect reconstruction, transfer and a stacked image. Six
    real surveys with 1500, 3000 and 4500 m streamers form the training pool and are split contiguously within
    each survey, while three further surveys and the Marmousi synthetic data are held out. At 20–80% random
    decimation, the compact network exceeds multichannel singular spectrum analysis by 2.5–5.9 dB and projection
    onto convex sets by 2.9–7.9 dB in missing-trace signal-to-noise ratio, and singular spectrum analysis ranks
    second at every level. Without fine-tuning, it scores about 3–5 dB lower on the held-out surveys than on the
    internal test. The Chai U-Net gains about 1 dB on the internal test, but its advantage depends on the domain: it
    is smaller on the held-out surveys and on Marmousi recorded with a 2575 m streamer, a length never seen in
    training, and larger on Marmousi with the 1500 m streamer. Replacing its mean-squared-error objective with
    a composite objective improves its transfer on gathers, whereas streamer-length conditioning has only a small,
    backbone-dependent effect. On one held-out line, all deep learning configurations yield visually similar stacks,
    scoring 5.96–6.37 dB against the reference with section-wise gain control, compared with 0.90–1.14 dB for the
    classical methods and 3.48 dB with gaps unfilled. The compact network achieves this with one tenth of the
    parameters and 28% of the training time per epoch. Large contiguous far-offset gaps, however, remain poorly
    reconstructed. Pooled training is therefore a practical option for lines of different streamer lengths, and tests
    across acquisition systems are the next step.},
  selected = {true},
  bibtex_show = {true}
}

@INPROCEEDINGS{Pignelli2024,
  author={Pignelli, Rogerio and Scalassara, Paulo R. and Dajer, María E. and Spatti, Danilo H.},
  booktitle={2024 IEEE 22nd Mediterranean Electrotechnical Conference (MELECON)}, 
  title={Feature Selection and Comparison of Classifiers for Reinke’s Edema Identification}, 
  year={2024},
  volume={},
  number={},
  pages={317-322},
  publisher={IEEE},
  keywords={Support vector machines;Training;Accuracy;Speech recognition;Multilayer perceptrons;Feature extraction;Wavelet analysis;Speech analysis;feature evaluation and selection;wavelets;neural networks;pattern recognition},
  doi={10.1109/MELECON56669.2024.10608503},
  url={https://ieeexplore.ieee.org/document/10608503},
  selected={true},
  bibtex_show={true},
  abstract={This study focus in the detection of Reinke’s edema based on vowel recordings. This benign disorder is characterized as edematous changes on the vocal folds, altering the produced voice. In order to assist in the diagnosis, we analyzed the effectiveness of Wavelet-Packet decomposition with different families (Haar and Daubechies) up to the seventh level of sustained vowel signals and compared the performance of support vector machine and multilayer perceptron classifiers to identify this disorder. One of the contributions of this work is to provide a filter method for selecting attributes from the Wavelet decomposition leaves. We show that less than 50% of the leaves are relevant for classification, but the ones from the initial, central, and final portions of the decomposition proved to be important, indicating that components from all frequency ranges help in the detection of Reinke’s edema. The Daubechies db5 family showed the highest overall accuracy in the tests, and the db2 family proved to be more consistent. It can be seen that the support vector machine, in addition to performing comparably to the multilayer perceptron, stands out for its significantly shorter training times, contributing to the practical viability of this approach in diagnosing Reinke’s edema.}
  }

  @INPROCEEDINGS{PIGNELLI_CBEB_2024,
    author = {Pignelli, Rogerio and Castoldi, Marcelo F. and Dajer, Maria E. and Spatti, Danilo H. and Scalassara, Paulo R.},
    title = {Binary optimization algorithms applied to multilayer perceptron hyperparameter selection for Reinke's edema identification},
    booktitle = {Proceedings of the Brazilian Congress of Biomedical Engineering (CBEB)},
    note = {Original title in Portuguese.},
    year = {2024},
    publisher = {SBEB},
    address = {Ribeir\~{a}o Preto, Brasil},
    url = {https://sbeb.org.br/cbeb2024/wp-content/uploads/2024/09/work-482.pdf},
    selected = {true},
    bibtex_show = {true},
    abstract = {The article presents a comparative analysis of four approaches to optimizing the hyperparameters of MLPs in the classification
of Reinke's edema. The study compared a traditional metaheuristic method, PSO, and a recent one, WOA. The work's
highlight came in the BPSO algorithm's performance, particularly when applied with the transfer function in S. This method
achieved rapid convergence and superior results, contrasting with the rapid saturation in local maximum observed in BWOA. A
comparison with random attribute selection revealed that although this approach found solutions with higher values, its random
nature prevented convergence and local exploration, which are crucial characteristics in metaheuristic algorithms. The study
concludes that BPSO with an S-shaped transfer function significantly improves the performance of MLPs in classifying
Reinke's edema from speech samples with a sustained vowel. Future work is suggested to explore other optimization
algorithms and validate these approaches on different data sets, covering classification and regression problems.}
}

